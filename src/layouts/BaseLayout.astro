---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_NAME } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  image,
  type = 'website',
} = Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const ogImage = image ? new URL(image, canonical) : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e5" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="知识博客 RSS" href={`${base}rss.xml`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <title>{fullTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('knowledge-blog-theme');
        const preferred = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = saved || preferred;
      })();
    </script>
  </head>
  <body>
    <div class="page-shell">
      <Header />
      <main><slot /></main>
      <Footer />
    </div>
    <script is:inline>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('knowledge-blog-theme', next);
      });
    </script>
  </body>
</html>
