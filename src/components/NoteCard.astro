---
import type { Note } from '../lib/notes';
import { getNoteDate, notePath } from '../lib/notes';

interface Props { note: Note; }
const { note } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const date = getNoteDate(note);
---

<article class="note-card">
  <div class="note-card-meta">
    <time datetime={date.toISOString()}>{date.toLocaleDateString('zh-CN')}</time>
    <span aria-hidden="true">·</span>
    <span>{note.data.tags.length ? note.data.tags.join(' / ') : '未分类'}</span>
  </div>
  <h2><a href={`${base}${notePath(note.id).slice(1)}`}>{note.data.title}</a></h2>
  <p>{note.data.description}</p>
  <a class="read-more" href={`${base}${notePath(note.id).slice(1)}`} aria-label={`阅读《${note.data.title}》`}>继续漫游 →</a>
</article>
