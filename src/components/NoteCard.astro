---
import type { Note } from '../lib/notes';
import { getNoteDate, notePath } from '../lib/notes';

interface Props { note: Note; }
const { note } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const date = getNoteDate(note);
---

<article class="note-card">
  <span class="note-card-index" aria-hidden="true">{String(note.id).padStart(2, '0')}</span>
  <div class="note-card-body">
    <h2><a href={`${base}${notePath(note.id).slice(1)}`}>{note.data.title}</a></h2>
    <p>{note.data.description}</p>
    <div class="note-card-meta"><time datetime={date.toISOString()}>{date.toLocaleDateString('zh-CN')}</time>{note.data.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}</div>
  </div>
  <a class="read-more" href={`${base}${notePath(note.id).slice(1)}`} aria-label={`阅读《${note.data.title}》`}>阅读 <span>↗</span></a>
</article>
