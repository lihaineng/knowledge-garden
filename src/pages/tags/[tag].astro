---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { getAllTags, getPublishedNotes } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  return getAllTags(notes).map(([tag]) => ({ params: { tag }, props: { tag, notes: notes.filter((n) => n.data.tags.includes(tag)) } }));
}
const { tag, notes } = Astro.props;
---

<BaseLayout title={`主题：${tag}`} description={`知识博客中关于“${tag}”的文章。`}>
  <header class="page-intro"><p class="eyebrow">TOPIC ARCHIVE</p><h1>#{tag}</h1><p>这个主题下有 {notes.length} 篇文章。</p></header>
  <div class="note-grid full">{notes.map((note) => <NoteCard note={note} />)}</div>
</BaseLayout>
