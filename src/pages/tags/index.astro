---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPublishedNotes } from '../../lib/notes';
const tags = getAllTags(await getPublishedNotes());
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<BaseLayout title="主题" description="按主题浏览知识博客。">
  <header class="page-intro"><p class="eyebrow">ALL TOPICS</p><h1>文章主题</h1><p>从关键词进入一组相关的思考与实践。</p></header>
  <div class="tag-directory">
    {tags.map(([tag, count]) => <a href={`${base}tags/${encodeURIComponent(tag)}/`}><span>{tag}</span><strong>{count}</strong></a>)}
  </div>
</BaseLayout>
