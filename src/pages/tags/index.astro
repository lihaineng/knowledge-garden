---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPublishedNotes } from '../../lib/notes';
const tags = getAllTags(await getPublishedNotes());
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<BaseLayout title="标签" description="沿着主题探索知识花园。">
  <header class="page-intro"><p class="eyebrow">GARDEN PATHS</p><h1>主题小径</h1><p>同一篇笔记可以出现在多条路上。</p></header>
  <div class="tag-directory">
    {tags.map(([tag, count]) => <a href={`${base}tags/${encodeURIComponent(tag)}/`}><span>{tag}</span><strong>{count}</strong></a>)}
  </div>
</BaseLayout>
