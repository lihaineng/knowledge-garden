---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<BaseLayout title="迷路了" description="这条小径暂时不存在。">
  <section class="not-found"><span>404</span><h1>这篇文章不存在。</h1><p>它可能已改名、移动，或还没有发布。</p><a class="button primary" href={base}>返回首页</a></section>
</BaseLayout>
