---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<BaseLayout title="迷路了" description="这条小径暂时不存在。">
  <section class="not-found"><span>404</span><h1>这条小径还没有长出来。</h1><p>也许它换了名字，或者只是暂时藏在雾里。</p><a class="button primary" href={base}>返回花园</a></section>
</BaseLayout>
