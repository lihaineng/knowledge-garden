---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { getPublishedNotes } from '../../lib/notes';
const notes = await getPublishedNotes();
---

<BaseLayout title="全部文章" description="知识博客中的全部公开文章。">
  <header class="page-intro"><p class="eyebrow">ALL ARTICLES</p><h1>全部文章</h1><p>持续写作，把零散经验变成可以检索和复用的知识。</p></header>
  <div class="note-grid full">{notes.map((note) => <NoteCard note={note} />)}</div>
</BaseLayout>
