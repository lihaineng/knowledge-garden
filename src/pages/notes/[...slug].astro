---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNoteDate, getPublishedNotes } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const date = getNoteDate(note);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<BaseLayout title={note.data.title} description={note.data.description} type="article">
  <article class="note-page" data-pagefind-body>
    <header class="note-header">
      <p class="eyebrow">GARDEN NOTE</p>
      <h1 data-pagefind-meta="title">{note.data.title}</h1>
      <p class="note-description">{note.data.description}</p>
      <div class="note-byline">
        <time datetime={date.toISOString()}>最近生长于 {date.toLocaleDateString('zh-CN')}</time>
        {note.data.tags.map((tag: string) => <a data-pagefind-filter={`tag:${tag}`} href={`${base}tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
      </div>
    </header>
    <div class="note-layout">
      <div class="prose"><Content /></div>
      {headings.length > 1 && (
        <aside class="toc" aria-label="本文目录">
          <p>本文路径</p>
          <ol>{headings.filter((h) => h.depth <= 3).map((h) => <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>
