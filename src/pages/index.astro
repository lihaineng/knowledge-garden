---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import { getAllTags, getPublishedNotes } from '../lib/notes';
import { NEW_ARTICLE_URL } from '../lib/site';

const notes = await getPublishedNotes();
const featured = notes[0];
const recent = notes.slice(1, 6);
const tags = getAllTags(notes).slice(0, 10);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">KNOWLEDGE ARCHIVE / 2026</p>
      <h1>记录正在<br /><span>发生的思考。</span></h1>
      <p class="hero-intro">这里是一个轻量的个人知识档案。写作、阅读、工具和实践，都被整理成可以回看的文章。</p>
      <div class="hero-actions"><a class="button primary" href={NEW_ARTICLE_URL} target="_blank" rel="noreferrer">打开 GitHub 写作 <span>↗</span></a><a class="button ghost" href={`${base}notes/`}>浏览归档</a></div>
    </div>
    <div class="hero-panel"><div class="hero-panel-top"><span>ARCHIVE / 001</span><span>LIVE</span></div><div class="hero-glyph">知</div><p>一边学习，一边记录；一边记录，一边形成自己的方法。</p><div class="hero-stats"><div><strong>{notes.length}</strong><span>篇文章</span></div><div><strong>{getAllTags(notes).length}</strong><span>个主题</span></div><div><strong>GH</strong><span>持续发布</span></div></div></div>
  </section>

  <section class="blog-ticker" aria-label="博客概览"><span>PERSONAL ARCHIVE</span><i></i><span>WRITE IN MARKDOWN</span><i></i><span>PUBLISH WITH GITHUB</span></section>

  {featured && (
    <section class="featured">
      <div class="featured-label"><span>PINNED</span><small>置顶文章</small></div>
      <div class="featured-copy">
        <p class="mono-label">{featured.data.tags.join(' · ')}</p>
        <h2><a href={`${base}notes/${featured.id}/`}>{featured.data.title}</a></h2>
        <p>{featured.data.description}</p>
        <a href={`${base}notes/${featured.id}/`}>阅读文章 <span>→</span></a>
      </div>
      <div class="featured-number">01</div>
    </section>
  )}

  <section class="section-block">
    <div class="section-heading">
      <div><p class="eyebrow">LATEST ARTICLES</p><h2>最新文章</h2></div>
      <a href={`${base}notes/`}>查看全部 →</a>
    </div>
    <div class="note-grid">{recent.map((note) => <NoteCard note={note} />)}</div>
  </section>

  <section class="topics-panel">
    <div>
      <p class="eyebrow">BROWSE BY TOPIC</p>
      <h2>按主题阅读</h2>
      <p>从一个关键词出发，找到相关的观察、方法与实践。</p>
    </div>
    <div class="tag-cloud">
      {tags.map(([tag, count]) => <a href={`${base}tags/${encodeURIComponent(tag)}/`}>{tag}<sup>{count}</sup></a>)}
      {tags.length === 0 && <span class="muted">还没有主题。</span>}
    </div>
    <a class="topics-link" href={`${base}tags/`}>全部主题 ↗</a>
  </section>
</BaseLayout>
